SITE_NAME=Linkwache
# Public address (canonical, hreflang, og:url, links in Telegram/mail). PUBLIC_URL wins over the older name SITE_URL.
PUBLIC_URL=https://linkwache.example.com
SITE_URL=https://linkwache.example.com
# Earlier public host names, comma-separated: their HTML pages answer 301 to PUBLIC_URL. The API, the Telegram
# webhook and files stay reachable there (installed apps keep using the address they were built with).
LEGACY_HOSTS=
CONTACT_MAIL=linkwache@example.com
PAYPAL_MAIL=paypal@example.com
TELEGRAM_BOT=
MAIL_IN=off
SAFE_BROWSING_KEY=
URLSCAN_KEY=
URLHAUS_KEY=
TELEGRAM_TOKEN=
TELEGRAM_SECRET=
# Impressum (Pflicht in DE) — steht bewusst NICHT im Quelltext
LEGAL_NAME=Vorname Nachname
LEGAL_STREET=Straße Hausnummer
LEGAL_CITY=PLZ Ort
LEGAL_PLACE=Ort, Bundesland
# Operator page /admin (empty = page disabled). Generate: openssl rand -hex 24
ADMIN_TOKEN=
# Daily GitHub check for a newer release (on|off)
UPDATE_CHECK=on
# Limits of the app/extension API /api/v1/check (per installation id and per address)
V1_PER_MINUTE=60
V1_PER_DAY=3000
V1_IP_PER_MINUTE=120
V1_IP_PER_DAY=10000

<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only for a self-hosted server inside the home network (the app enforces
     https for public addresses itself, see Link.validServer). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

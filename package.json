{
  "name": "linkwache",
  "version": "0.8.7",
  "private": true,
  "description": "Linkwache — prüft verdächtige Links, ohne sie zu öffnen. Cloudflare Worker.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js extension/test/*.test.js",
    "build:extension": "node extension/scripts/build.mjs",
    "test:e2e:extension": "python3 extension/test/e2e/e2e.py"
  },
  "dependencies": {
    "mimetext": "^3.0.24",
    "postal-mime": "^4.2.1",
    "qrcode-generator": "2.0.4",
    "tldts": "^6.1.86"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "wrangler": "^4.0.0"
  }
}
